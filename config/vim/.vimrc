" ============================================================================
" 基础设置（必须放在最前面）
" ============================================================================
set nocompatible              " 关闭 vi 兼容模式，启用 Vim 增强功能（必须放最前）
filetype on                   " 开启文件类型检测
filetype plugin on            " 根据文件类型加载对应插件
filetype indent on            " 根据文件类型加载对应缩进规则
syntax enable                 " 开启语法高亮

" ============================================================================
" 编码设置（防止中文乱码）
" ============================================================================
set encoding=utf-8            " Vim 内部使用的编码
set fileencoding=utf-8        " 当前文件保存时使用的编码
set fileencodings=utf-8,gb2312,gb18030,gbk,ucs-bom,cp936,latin1  " 打开文件时尝试的编码顺序
set termencoding=utf-8        " 终端使用的编码
set fileformats=unix,dos,mac  " 换行符兼容顺序：优先 unix 风格

" ============================================================================
" 界面显示
" ============================================================================
set number                    " 显示行号
set relativenumber            " 显示相对行号（配合 number 形成混合行号，方便跳转）
set cursorline                " 高亮当前行
set ruler                     " 状态栏显示光标位置
set showmatch                 " 输入括号时高亮匹配的另一半
set showcmd                   " 在状态栏显示正在输入的命令
set showmode                  " 显示当前模式（INSERT/VISUAL 等）
set laststatus=2              " 总是显示状态栏
set wildmenu                  " 命令行补全增强（按 Tab 显示候选列表）
set wildmode=longest:full,full  " 补全先匹配最长公共部分，再循环候选项
set scrolloff=5               " 光标距离上下边缘至少保留 5 行
set sidescrolloff=5           " 光标距离左右边缘至少保留 5 列
set display=lastline          " 长行不折行时尽量显示完整尾部
set t_Co=256                  " 启用 256 色

" ============================================================================
" 搜索
" ============================================================================
set hlsearch                  " 高亮所有搜索匹配项
set incsearch                 " 边输入边搜索（增量搜索）
set ignorecase                " 搜索时忽略大小写
set smartcase                 " 如果搜索内容含大写字母，则恢复大小写敏感

" ============================================================================
" 缩进与制表符
" ============================================================================
set autoindent                " 新行自动继承上一行缩进
set smartindent               " 智能缩进（根据语法结构调整）
set expandtab                 " 用空格代替 Tab
set tabstop=4                 " 一个 Tab 显示为 4 个空格
set shiftwidth=4              " 自动缩进时使用 4 个空格
set softtabstop=4             " 编辑时按 Tab/Backspace 按 4 个空格处理
set shiftround                " 缩进时取整到 shiftwidth 的整数倍

" ============================================================================
" 编辑体验
" ============================================================================
set backspace=indent,eol,start  " 让退格键能跨越缩进、行首、插入起始位置
set mouse=a                   " 在所有模式下启用鼠标
set clipboard=unnamed         " 默认使用系统剪贴板（macOS 上 yy/p 与系统互通）
set hidden                    " 允许在未保存的缓冲区之间切换
set autoread                  " 文件被外部修改时自动重新加载
set history=1000              " 命令历史记录条数
set undolevels=1000           " 撤销历史条数
set timeoutlen=500            " 映射键序列等待时间（毫秒）
set ttimeoutlen=10            " 终端按键码等待时间（按 ESC 后响应更快）

" ============================================================================
" 文件与备份
" ============================================================================
set nobackup                  " 不生成备份文件（~ 结尾）
set nowritebackup             " 保存时不生成临时备份
set noswapfile                " 不生成 swap 文件
" 如需持久化撤销，取消下面注释（首次使用前需手动创建 ~/.vim/undodir 目录）
" set undofile
" set undodir=~/.vim/undodir

" ============================================================================
" 视觉提示
" ============================================================================
set list                      " 显示不可见字符
set listchars=tab:»·,trail:·,extends:>,precedes:<,nbsp:+  " 自定义不可见字符样式
" set colorcolumn=80          " 在第 80 列显示一条竖线（按需开启）

" ============================================================================
" 提示音 / 视觉响铃
" ============================================================================
set noerrorbells              " 关闭错误提示音
set novisualbell              " 关闭视觉响铃
set t_vb=                     " 清空视觉响铃终端代码

" ============================================================================
" 按键映射
" ============================================================================
let mapleader = ","           " 设置 leader 键为逗号

" 快速取消搜索高亮
nnoremap <silent> <leader><space> :nohlsearch<CR>

" 快速保存 / 退出
nnoremap <leader>w :w<CR>
nnoremap <leader>q :q<CR>

" 在可视模式下保持选区，反复缩进
vnoremap < <gv
vnoremap > >gv

" 让 j/k 在折行的可视行间移动，而非物理行
nnoremap j gj
nnoremap k gk

" ============================================================================
" 自动命令
" ============================================================================
" 打开文件时自动跳到上次编辑位置
augroup remember_last_position
    autocmd!
    autocmd BufReadPost *
        \ if line("'\"") > 1 && line("'\"") <= line("$") |
        \   execute "normal! g`\"" |
        \ endif
augroup END
